<% layout('layout') %>
    <head>
        <style>
            td {
                font-size: 0.8vw;
            }
            .mainf {
                position: relative;
            }
            
            .resident-list {
                width: 100%;
                height: auto;
                overflow-y: auto;
                z-index: 10;
            }
            .resident-item {
                padding: 5px 10px;
                cursor: pointer;
            }
            .resident-item:hover {
                background: white;
            }
        </style>
    </head>
    <% businesses.forEach(business => { %>
<div id="editFormContainer" class="abstractBG borderRadius20 unseen">
    <form action="/update-business/<%= business._id %>" method="POST" class="flex col alignStart" style="width: 40%; padding: 50px;">
        <p class="size40 str400">UPDATE BUSINESS</p>

        <!-- Business Name -->
        <label for="businessName">Business Name</label>
        <input type="text" id="businessName" name="businessName" required>

        <!-- Business Type -->
        <label for="businessType">Business Type</label>
        <input type="text" id="businessType" name="businessType" required>

        <div class="height0 gap5">
                        
            <div class="height0 col alignStart">
                <label for="businessType">House No.</label>
                <input type="text" id="houseNo" name="houseNo" required>
            </div>
            
            <div class="height0 col alignStart">
                <label for="businessType">Purok</label>
                <input type="text" id="purok" name="purok" required>
            </div>
        </div>

        <br><hr><br>

        <!-- Owner Name -->
        <label for="ownerName">Owner Name</label>
        <div class="selectBar widthMax100">
            <select name="ownerName" id="ownerNameSelect" required>
                <% if (residents && residents.length > 0) { %>
                    <% residents.forEach((resident) => { %>
                        <option value="<%= resident._id %>" <%= business.ownerName == resident._id ? 'selected' : '' %>>
                            <%= resident.firstName %> <%= resident.middleName %> <%= resident.lastName %>
                        </option>
                    <% }) %>
                <% } else { %>
                    <option disabled>No residents found</option>
                <% } %>
            </select>
        </div>


        <br>
        <div class="height0 gap5">
            <button class="nav fnav" type="button" onclick="closeEditForm()">Cancel</button>
            <button class="nav fnav pnav" type="submit">Update Business</button>
        </div>
    </form>
</div>
<% }) %>




<script>
    function closeEditForm() {
        document.getElementById('editFormContainer').classList.add('unseen');
    }

    function editBusiness(id, businessName, businessType, ownerId, contactNumber, houseNo, purok) {
        const formContainer = document.getElementById('editFormContainer');
        formContainer.classList.remove('unseen');

        const form = formContainer.querySelector('form');
        form.action = `/update-business/${id}`;

        document.getElementById('businessName').value = businessName;
        document.getElementById('businessType').value = businessType;
        document.getElementById('houseNo').value = houseNo;
        document.getElementById('purok').value = purok;

        // Find and set the correct owner in the select dropdown
        const ownerSelect = document.getElementById('ownerNameSelect');
        for (let i = 0; i < ownerSelect.options.length; i++) {
            if (ownerSelect.options[i].value === ownerId) {
                ownerSelect.selectedIndex = i;
                break;
            }
        }
    }
</script>


<div class="borderRadius20 abstractBG unseen" id="newCard">
    <form action="/add-business" method="POST" class="relative" style="height: auto; width: 40%; padding: 50px; position: relative; border-radius: 20px;">
    <a href="javascript:void(0)" class="nav cnav absolute right20 top20" id="closeBtn">
        <i class="fas fa-times"></i>
    </a>
    <div class="height0 gap30">
        <div class="height0 col gap15">
            <div class="row head">
                <p class="size34 str400 green">New Business</p>
            </div>
            
            <div class="row">
                <div class="field">
                    <label>Business Name</label>
                    <input type="text" name="businessName" placeholder="Enter business name" required>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label>Business Type</label>
                    <input type="text" name="businessType" placeholder="e.g. Coffee Shop, Gasoline Store" required>
                </div>
            </div>
            <div class="row">
                <div class="field">
                    <label>House No.</label>
                    <input type="text" name="houseNo" placeholder="Enter house number" required>
                </div>
                <div class="field">
                    <label>Purok</label>
                    <div class="selectBar">
                        <select name="purok" required>
                            <option value="">Select</option>
                            <option value="Dike Street">Dike Street</option>
                            <option value="Bagong Daan Street">Bagong Daan</option>
                            <option value="Cantarilla Street">Cantarilla</option>
                            <option value="Maharlika Highway">Highway</option>
                            <option value="Perigola Street">Perigola</option>
                            <option value="Shorcut Street">Shortcut</option>
                        </select>
                    </div>
                </div>
            </div>
            <hr>
            <div class=" height0 col alignStart">
                <label for="">Owner's Name</label>
                <input type="text"id="residentSearch" placeholder="Search resident name..." autocomplete="off" required />
                <input type="hidden" name="ownerName" id="selectedResidentId" />
                <div id="residentList" class="resident-list bgSoft col borderRadius5 marginTop5" style="overflow-y: auto; max-height: 100px !important; display: block;">
                    <p class="size12">Matched Results</p>
                </div>
            </div>

            <script>
            const residents = <%- JSON.stringify(residents || []) %>; // Pass from EJS
            const searchInput = document.getElementById('residentSearch');
            const resultList = document.getElementById('residentList');
            const hiddenInput = document.getElementById('selectedResidentId');

            // Handle typing
            searchInput.addEventListener('input', function() {
                const query = this.value.toLowerCase();
                resultList.innerHTML = '';

                if (query.length === 0) return;

                // Filter residents by name
                const filtered = residents.filter(resident =>
                `${resident.firstName} ${resident.middleName} ${resident.lastName}`
                    .toLowerCase()
                    .includes(query)
                );

                // Show results
                filtered.forEach(resident => {
                const div = document.createElement('div');
                div.classList.add('resident-item');
                div.textContent = `${resident.firstName} ${resident.middleName} ${resident.lastName}`;
                div.dataset.id = resident._id;

                div.addEventListener('click', () => {
                    searchInput.value = div.textContent; // show selected name
                    hiddenInput.value = div.dataset.id;  // store ID
                    resultList.innerHTML = '';           // clear list
                });

                resultList.appendChild(div);
                });
            });

            // Close list when clicking outside
            document.addEventListener('click', (e) => {
                if (!e.target.closest('.searchBar')) {
                resultList.innerHTML = '';
                }
            });
            </script>
            <div class="row">
                <div class="field btn" style="flex-direction: row;">
                    <button class="nav fnav pnav" type="submit">Add Record</button>
                </div>
            </div>
        </div>
    </div>
    </form>
</div> 

        
        <div class="height0 relative col">
            <img src="/images/bus.png" alt="" class="absolute bottom10 right30 h210 index50" style="transform: rotate(-5deg);">    
               
            <div class="height0">
                <div class="ctrl left gap10">
                    <div class="searchBar">
                        <input type="search" id="univ">
                        <i class="fas fa-search"></i>
                    </div>
                <a href="javascript:void(0)" class="nav borderNone paddingBlock12 borderRadius10"  id="exportRecords">
                    <i class="fa-solid fa-download"></i>
                    Export Excel File
                </a>
                <script>
                document.getElementById("exportRecords").addEventListener("click", async function(e) {
                    e.preventDefault();

                    const password = prompt("Enter your password to proceed:");

                    if (!password) return; // user canceled

                    try {
                        // Send password to server for verification
                        const res = await fetch("/verify-passwordX", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({ password })
                        });

                        const data = await res.json();

                        if (data.success) {
                            // Password correct → proceed to export
                            window.location.href = "/export-business";
                        } else {
                            alert("❌ Incorrect password!");
                        }
                    } catch (err) {
                        console.error(err);
                        alert("❌ Error verifying password!");
                    }
                });
                </script>  
                    <a href="/nonRes" class="nav borderRadius10"><i class="fas fa-plus"></i>Add Non-Resident</a> 
                    | 
                    <a href="/busArc" class="nav borderRadius10">
                        <i class="fa-solid fa-archive"></i>
                        Archive
                    </a> 
                </div>
            </div>
            <div class="h180 witch abstractBG borderRadius10 padding25 justifyStart col alignStart relative">
                <% if (user.position === "Punong Barangay" || user.position === "Barangay Secretary" || user.position === "Barangay Clerk") { %>
                    <a href="javascript:void()"  id="newBtn" class="nav borderNone absolute left25 bottom25 paddingBlock10 borderRadius10"><i class="fas fa-plus"></i>New Record</a>

                <% } %>
                <div class="height0 justifyStart alignStart col">
