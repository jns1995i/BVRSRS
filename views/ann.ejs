    <div id="notFound" class="size20 height0 width100 padding20 borderRadius10 hidden">Sorry, No record Found!</div>
    <br>
    <% if (announcements && announcements.length > 0) { %>
        <% announcements.forEach(ann => { %>
            <div class="card annCard darkShadow">
                
                <div class="section">
                    <p class="title"><%= ann.title %></p>
                </div>
                <div class="section annDate">
                    <%= ann.createdAt.toDateString() %>
                </div>
                <div class="section mainCN">
                    <p><%= ann.description %></p>
                </div>
                <div class="section annPhoto">
                    <% if (ann.image) { %>
                        <img src="<%= ann.image %>" alt="Announcement Image" width="100px" height="100px">
                    <% } else { %>
                        <p>No Image Available</p>
                    <% } %>
                </div>
                <div class="height0 right gap10">
                    <a href="javascript:void(0)" class="nav"
                    onclick="editAnnouncement(
                        '<%= ann._id %>',
                        <%= JSON.stringify(ann.title) %>,
                        <%= JSON.stringify(ann.description) %>,
                        <%= JSON.stringify(ann.image || '/images/default.jpg') %>
                    )">
                        <i class="fas fa-edit"></i> Modify
                    </a>                         
                    <form action="/deleteAnn/<%= ann._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this?');" class="width0 height0 transparent vers">
                        <button type="submit" class="nav dnav-fill">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                    
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <p>No announcements available.</p>
    <% } %>
</div><script>
    // ==============================
    // EDIT ANNOUNCEMENT LOGIC
    // ==============================

    // Open edit form and populate data
    function editAnnouncement(id, title, description, imageSrc) {
        try {
            // Close any other open modals first
            document.querySelectorAll('.seen').forEach(card => card.classList.replace('seen', 'unseen'));

            const editCard = document.getElementById("editCard" + id);
            if (!editCard) return alert("Edit form not found for this announcement.");

            // Populate fields safely
            document.getElementById("editId" + id).value = id;
            document.getElementById("editTitle" + id).value = title;
            document.getElementById("editDescription" + id).value = description;
            document.getElementById("editPreviewImage" + id).src =
                imageSrc && imageSrc !== "undefined" ? imageSrc : "/images/default.jpg";

            // Show the edit modal
            editCard.classList.remove("unseen");
            editCard.classList.add("seen");
        } catch (err) {
            console.error("Error opening edit form:", err);
        }
    }

    // Close edit form
    function closeEditForm(id) {
        const editCard = document.getElementById("editCard" + id);
        if (editCard) {
            editCard.classList.remove("seen");
            editCard.classList.add("unseen");
        }
    }

    // Preview file for EDIT announcement
    function previewEditFile(id) {
        const input = document.getElementById("imageInput" + id);
        const preview = document.getElementById("editPreviewImage" + id);
        const file = input?.files?.[0];

        if (file) {
            const reader = new FileReader();
            reader.onload = () => (preview.src = reader.result);
            reader.readAsDataURL(file);
        }
    }

    // Preview file for NEW announcement
    function previewFile() {
        const fileInput = document.querySelector('#newCard input[name="image"]');
        const preview = document.getElementById("previewImage");
        const file = fileInput?.files?.[0];

        if (file) {
            const reader = new FileReader();
            reader.onload = () => (preview.src = reader.result);
            reader.readAsDataURL(file);
        }
    }

    // ==============================
    // DOM EVENT LOGIC
    // ==============================
    document.addEventListener("DOMContentLoaded", () => {
        const newForm = document.querySelector("#newCard form");
        const loadingMsg = document.getElementById("loadingMessage");
        const newBtn = document.getElementById("newBtn");
        const closeBtn = document.getElementById("closeBtn");
        const newCard = document.getElementById("newCard");
        const search = document.getElementById("univ");

        // Show loading message when submitting
        if (newForm && loadingMsg) {
            newForm.addEventListener("submit", () => (loadingMsg.style.display = "block"));
        }

        // Show new announcement form
        if (newBtn && newCard) {
            newBtn.addEventListener("click", (e) => {
                e.preventDefault();
                newCard.classList.remove("unseen");
                newCard.classList.add("seen");
            });
        }

        // Close new announcement form
        if (closeBtn && newCard) {
            closeBtn.addEventListener("click", () => {
                newCard.classList.remove("seen");
                newCard.classList.add("unseen");
            });
        }

        // Search filter
        if (search) {
            search.addEventListener("input", () => {
                const filter = search.value.toLowerCase();
                const cards = document.querySelectorAll(".main .card.annCard");
                let found = false;

                if (filter === "") {
                    cards.forEach(card => (card.style.display = "flex"));
                    document.getElementById("notFound").style.display = "none";
                    return;
                }

                cards.forEach((card) => {
                    const title = card.querySelector(".title")?.textContent.toLowerCase() || "";
                    const desc = card.querySelector(".mainCN p")?.textContent.toLowerCase() || "";

                    if (title.includes(filter) || desc.includes(filter)) {
                        card.style.display = "flex";
                        found = true;
                    } else {
                        card.style.display = "none";
                    }
                });

                document.getElementById("notFound").style.display = found ? "none" : "flex";
            });
        }
    });
</script>