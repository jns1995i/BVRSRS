<% layout('layout') %>

<style>
    input {
        min-height: 42px;
    }
</style>

<div class="height padding10 borderRadius15 relative abstractBG">
    <a href="/rsdView/<%= resident._id %>" class="hidden nav absolute left20 top20"><i class="fas fa-chevron-left"></i>Go Back</a>    
    <div class="height100 blockX overflow-y1 padding10 borderRadius15">
        <div class="height0 padding10">
            <form id="residentForm" action="/update-changeF/<%= resident._id %>" method="POST" class="height0 width50">
                <div class="gap10 justifyStart alignStart height0">
                    <div class="height0 col justifyStart alignStart">
                    <p class="size30 str500 colorPrimary">Reassign Family</p>
                    <br>

                    <div class="height0 col alignStart gap5">
                        <label for="familySearch">Search Family (by Head Name)</label>

                        <!-- 🔍 Searchable input -->
                        <input list="familyList" id="familySearch" placeholder="Search by head name..." class="widthMin100" required>
                        <datalist id="familyList">
                        <% familyOptions.forEach(fam => { %>
                            <option 
                            data-id="<%= fam.familyId %>" 
                            value="<%= fam.headName %>">
                            <% }) %>
                        </datalist>

                        <!-- Hidden field that actually sends the familyId -->
                        <input type="hidden" name="familyId" id="familyId" value="<%= resident.familyId ? resident.familyId.toString() : "" %>">
                    </div>

                    <br>

                    <div class="height0 gap5">
                        <div class="height0 col gap5 alignStart">
                        <label for="role">Family Membership</label>
                        <div class="selectBar widthMin100">
                            <select name="role" id="role" required>
                            <option value="" disabled <%= !resident.role ? "selected" : "" %>>Select Membership</option>
                            <option value="Head" <%= resident.role === "Head" ? "selected" : "" %>>Head</option>
                            <option value="Member" <%= resident.role === "Member" ? "selected" : "" %>>Member</option>
                            </select>
                        </div>
                        </div>
                    </div>

                    <br>

                    <div class="height0 gap5">
                        <div class="height0 col gap5 alignStart">
                        <label for="rel">Family Role</label>
                        <div class="selectBar widthMin100">
                            <select name="rel" id="rel" required>
                            <option value="" disabled <%= !resident.rel ? "selected" : "" %>>Select Role</option>
                            <option value="Father" <%= resident.rel === "Father" ? "selected" : "" %>>Father</option>
                            <option value="Mother" <%= resident.rel === "Mother" ? "selected" : "" %>>Mother</option>
                            <option value="Siblings" <%= resident.rel === "Siblings" ? "selected" : "" %>>Children</option>
                            <option value="Grand Parent" <%= resident.rel === "Grand Parent" ? "selected" : "" %>>Grand Parent</option>
                            <option value="Grandchild" <%= resident.rel === "Grandchild" ? "selected" : "" %>>Grandchild</option>
                            <option value="Relative" <%= resident.rel === "Relative" ? "selected" : "" %>>Relative</option>
                            </select>
                        </div>
                        </div>
                    </div>

                    <br>

                    <div class="height0 justifyBetween">
                        <a href="/rsdView/<%= resident._id %>" class="nav"><i class="fas fa-chevron-left"></i>Cancel</a>  
                        <button type="submit" class="nav pnav"><i class="fas fa-check-square"></i>Update Record</button>
                    </div>
                    </div>
                </div>
            </form>
        </div>
        
        
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const familySearch = document.getElementById("familySearch");
  const familyIdInput = document.getElementById("familyId");
  const datalist = document.getElementById("familyList");

  familySearch.addEventListener("input", () => {
    const val = familySearch.value.trim();
    const option = Array.from(datalist.options).find(opt => opt.value === val);
    familyIdInput.value = option ? option.dataset.id : "";
  });
});
</script>